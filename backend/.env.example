# SRIKANDI Naskah AI — proxy backend
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env

# Port & host. Default bind 127.0.0.1 supaya hanya Caddy/nginx yang bisa
# mengakses. Di Docker HARUS 0.0.0.0 (sudah diatur di docker-compose.yml).
HOST=127.0.0.1
PORT=8787

# --- Upstream OpenAI-compatible (default: Kenari) ---
UPSTREAM_BASE_URL=https://kenari.id/v1
# Key Kenari yang lama dianggap bocor — buat key BARU di panel Kenari.
UPSTREAM_API_KEY=

# --- Upstream Anthropic (opsional; kosongkan bila tak dipakai) ---
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=

# --- Token aplikasi untuk pengguna extension (BUKAN key AI) ---
# Pisahkan beberapa token dengan koma. Generate: openssl rand -hex 32
APP_TOKENS=

# --- Batasan ---
# Batas ukuran body request (byte). Extension memotong teks di ~30k karakter,
# jadi 400KB sangat longgar.
MAX_BODY_BYTES=400000
# Kuota request per token per jam.
RATE_LIMIT_PER_HOUR=60
# Timeout menunggu respon endpoint AI (AI bisa lambat; jangan terlalu kecil).
UPSTREAM_TIMEOUT_MS=120000
